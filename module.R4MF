R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=SSHD
VERSION=0.1.20
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ZIG_MODULE=path_text:../../Libraries/R4STD/Bindings/Zig/path_text.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/SSHD.R4X
IMAGE_SCOPE=full
IMPORT=R4SYS:Query2:2
IMPORT=R4NET:Query2:2
IMPORT=R4DESK:Query2:2
IMPORT=R4DEV:Query2:2
META=memory.profile=large-service
META=memory.tag=ssh
META=service.name=SSHD
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
META=transfer.profile=large-update-inbox
