R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=SSHD
VERSION=0.1.1
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/SSHD.R4X
IMAGE_SCOPE=full
IMPORT=R4SYS:Query:1
IMPORT=R4NET:Query:1
IMPORT=R4DESK:Query:1
META=memory.profile=large-service
META=memory.tag=ssh
META=service.name=SSHD
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
META=transfer.profile=large-update-inbox
